# Copy this file to .env and fill only APIs you are authorized to use.
HOST=0.0.0.0
PORT=8787
UPSTREAM_TIMEOUT_MS=8000
SEARCH_LIMIT=20

# Optional shared API token. If enabled, configure the same token in the private
# MusicFree plugin build. Never commit real tokens to GitHub.
API_TOKEN=

# Each upstream must implement the API contract in server/README.md.
NETEASE_SEARCH_URL=
NETEASE_PLAY_URL=
NETEASE_TOKEN=

QQ_SEARCH_URL=
QQ_PLAY_URL=
QQ_TOKEN=

KUGOU_SEARCH_URL=
KUGOU_PLAY_URL=
KUGOU_TOKEN=

KUWO_SEARCH_URL=
KUWO_PLAY_URL=
KUWO_TOKEN=

BILIBILI_SEARCH_URL=
BILIBILI_PLAY_URL=
BILIBILI_TOKEN=
